{
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300,
      "includeFiles": "src/data/guides/**"
    }
  },
  "rewrites": [
    {
      "source": "/oauth/start",
      "destination": "/api/oauth?p=google&s=start"
    },
    {
      "source": "/oauth/callback",
      "destination": "/api/oauth?p=google&s=callback"
    },
    {
      "source": "/oauth/:p/:s",
      "destination": "/api/oauth?p=:p&s=:s"
    },
    {
      "source": "/((?!api/|evidence/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}